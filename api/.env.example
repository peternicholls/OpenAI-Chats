# API Backend Configuration
# ========================

# Database path - where to find/create the SQLite database
CHATGPT_ARCHIVE_DB=/data/chats.db

# API host binding
# Use 0.0.0.0 for Docker/container deployments (accessible from all interfaces)
# Use 127.0.0.1 for local-only access (more secure for development)
# Note: Binding to 0.0.0.0 triggers a security warning at startup
API_HOST=0.0.0.0
API_PORT=8000

# CORS allowed origins - JSON array of allowed frontend URLs
# Must be valid JSON array format
CORS_ORIGINS=["http://localhost:3000"]

# OpenAI API key (optional - required for semantic search/embeddings)
# OPENAI_API_KEY=sk-...

# Disable rate limiting - for automated testing ONLY.
# NEVER set this to 1 in a production or shared environment.
# DISABLE_RATE_LIMIT=1
